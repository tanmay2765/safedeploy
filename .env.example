# SafeDeploy Environment Configuration Template
# Copy this file to .env before starting the platform: cp .env.example .env

# Core Platform Settings
ENVIRONMENT=development
DEBUG=true

# Database Settings (PostgreSQL)
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=safedeploy_user
POSTGRES_PASSWORD=safedeploy_password
POSTGRES_DB=safedeploy_db

# Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Browser-Accessible API URL (Used by client-side browser requests)
# IMPORTANT: Do not use the internal Docker hostname ("backend:8000") here,
# as user browsers cannot resolve Docker container hostnames.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Monitoring & CI/CD (Optional / Future Phases)
JENKINS_URL=http://localhost:8080
PROMETHEUS_URL=http://localhost:9090

